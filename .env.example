# Scripted mode needs no key. Switch to anthropic explicitly for live calls.
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEMO_DB=data/demo.sqlite3

# Optional cloud warehouse for local Uvicorn (see docs/bigquery.md).
BIGQUERY_ENABLED=false
BIGQUERY_PROJECT=
BIGQUERY_TABLE=
BIGQUERY_LOCATION=US
BIGQUERY_MAX_BYTES_BILLED=33554432
